# Copy to jenkins/.env and fill in. jenkins/.env is git-ignored.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me

# Docker Hub username and an access token (Account settings > Personal access tokens, Read & Write)
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# Gmail address and a 16-character app password (Google Account > Security > App passwords)
SMTP_USERNAME=
SMTP_PASSWORD=

# Where build notifications are sent
NOTIFY_EMAIL=
